{
  "name": "notify-inbound_numbers_suite",
  "expectations": [
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "meta": {
        "description": "id should match UUID format"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "number",
        "regex": ".*"
      },
      "meta": {
        "description": "number should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "provider",
        "regex": ".*"
      },
      "meta": {
        "description": "provider should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "service_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "meta": {
        "description": "service_id should match UUID format"
      }
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "active",
        "value_set": [
          true,
          false
        ]
      },
      "meta": {
        "description": "active should be boolean-like values"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "created_at",
        "type_list": [
          "datetime64",
          "datetime64[ns]",
          "<M8[us]",
          "TimestampType",
          "timestamp"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "updated_at",
        "type_list": [
          "datetime64",
          "datetime64[ns]",
          "<M8[us]",
          "TimestampType",
          "timestamp"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "year",
        "regex": "^\\d{4}$"
      },
      "meta": {
        "description": "year should be a 4-digit year (e.g., 2024)"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "month",
        "regex": "^\\d{4}-\\d{2}$"
      },
      "meta": {
        "description": "month should be in the format yyyy-mm (e.g., 2024-06)"
      }
    }
  ]
}
