{
  "name": "notify-user_to_service_suite",
  "expectations": [
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "user_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "meta": {
        "description": "user_id should match UUID format"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "service_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
      },
      "meta": {
        "description": "service_id should match UUID format"
      }
    }
  ]
}
