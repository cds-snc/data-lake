{
  "name": "forms-submissions_files_suite",
  "expectations": [
    {
      "type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "submission_id",
          "file_id",
          "file_size",
          "timestamp"
        ],
        "exact_match": false
      },
      "meta": {
        "description": "Ensure required columns are present, allowing extra columns"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "submission_id",
        "regex": ".*"
      },
      "meta": {
        "description": "submission_id should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "file_id",
        "regex": ".*"
      },
      "meta": {
        "description": "file_id should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "file_size",
        "min_value": 0
      },
      "meta": {
        "description": "file_size should be greater than 0"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "timestamp",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "timestamp",
        "min_value": "2000-01-01T00:00:00"
      },
      "meta": {}
    }
  ]
}
