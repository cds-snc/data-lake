{
  "name": "forms-templatetouser_suite",
  "expectations": [
    {
      "type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "templateid",
          "userid",
          "timestamp"
        ],
        "exact_match": false
      },
      "meta": {
        "description": "Ensure required columns are present, allowing extra columns"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "templateid",
        "regex": ".*"
      },
      "meta": {
        "description": "templateid should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "userid",
        "regex": ".*"
      },
      "meta": {
        "description": "userid should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "timestamp",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "timestamp",
        "min_value": "2000-01-01T00:00:00"
      },
      "meta": {}
    }
  ]
}
