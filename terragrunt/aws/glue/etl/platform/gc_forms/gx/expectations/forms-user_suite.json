{
  "name": "forms-user_suite",
  "expectations": [
    {
      "type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "id",
          "email",
          "emailverified",
          "lastlogin",
          "active",
          "createdat",
          "notes",
          "timestamp",
          "canpublish",
          "year",
          "month"
        ],
        "exact_match": false
      },
      "meta": {
        "description": "Ensure required columns are present, allowing extra columns"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "id",
        "regex": "^[a-z0-9]{1,30}$"
      },
      "meta": {
        "description": "id should be 1 to 30 characters long (e.g., clsbvg7z20068xd82jp1jf7sd)"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "email",
        "regex": ".*"
      },
      "meta": {
        "description": "email should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "emailverified",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "emailverified",
        "min_value": "1950-01-01T00:00:00"
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "lastlogin",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "lastlogin",
        "min_value": "2000-01-01T00:00:00"
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "active",
        "value_set": [
          true,
          false
        ]
      },
      "meta": {
        "description": "active should be boolean-like values"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "createdat",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "createdat",
        "min_value": "2000-01-01T00:00:00"
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "notes",
        "regex": ".*"
      },
      "meta": {
        "description": "notes should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_be_in_type_list",
      "kwargs": {
        "column": "timestamp",
        "type_list": [
          "datetime64",
          "datetime64[ns]"
        ]
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "timestamp",
        "min_value": "2000-01-01T00:00:00"
      },
      "meta": {}
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "canpublish",
        "regex": ".*"
      },
      "meta": {
        "description": "canpublish should be string-like"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "year",
        "regex": "^\\d{4}$"
      },
      "meta": {
        "description": "year should be a 4-digit year (e.g., 2024)"
      }
    },
    {
      "type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "month",
        "regex": "^\\d{4}-\\d{2}$"
      },
      "meta": {
        "description": "month should be in the format yyyy-mm (e.g., 2024-06)"
      }
    }
  ]
}
